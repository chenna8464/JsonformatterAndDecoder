# Copy to .env for local development. .env itself is git-ignored.
#
# Only non-secret, server-side values belong here. Anything Vite exposes to the
# browser must be prefixed VITE_ and is therefore public — never put a secret
# behind a VITE_ prefix, it ends up in the JS bundle that ships to every visitor.

# Message returned by GET /api/ping.
PING_MESSAGE="ping pong"
